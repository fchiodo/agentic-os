{
  "name": "agent-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:desktop": "tauri dev",
    "prepare:markitdown": "node scripts/build-markitdown-sidecar.mjs",
    "prepare:ocr": "node scripts/build-ocr-sidecar.mjs",
    "prepare:sidecars": "pnpm prepare:markitdown && pnpm prepare:ocr",
    "bootstrap:mac": "./scripts/bootstrap-macos.sh",
    "build": "tsc -b && vite build",
    "build:desktop": "tauri build && pnpm sync:desktop-app",
    "sync:desktop-app": "./scripts/sync-desktop-app.sh",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:ocr": "node scripts/check-ocr-sidecar.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ocr": "python3.10 -m unittest discover -s tools/ocr-sidecar/tests -p 'test_*.py' -v",
    "test:ocr:integration": "python3.10 tools/ocr-sidecar/tests/run_real_smoke.py",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/api": "^2.11.0",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "sigma": "^3.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
